{
  "name": "jianzj-hub",
  "version": "0.0.0",
  "private": true,
  "description": "工作站 — M0 compatibility probes only",
  "main": "out/main/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "electron-vite build",
    "m0:run": "node scripts/m0/run.mjs dev",
    "m0:package": "node scripts/m0/package.mjs",
    "m0:packaged": "node scripts/m0/run.mjs packaged",
    "test": "node --test tests/m0/*.test.mjs",
    "m0:prepare": "node scripts/m0/prepare.mjs",
    "m0:check": "node scripts/m0/preflight.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "13.0.3",
    "koffi": "3.3.3",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.7"
  }
}
